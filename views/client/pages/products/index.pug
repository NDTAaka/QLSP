extends ../../layouts/default.pug

block main
  .containr.my-3 
    .row 
      .col-12 
        .box-head 
          h2.inner-title Danh sách sản phẩm 
    
    .row 
      each item in products
        .col-4.mb-3 
          .product-item 
            .inner-images
              img(
                src=item.thumbnail
              )
            .inner-content
                h3.inner-title #{item.title}
                .inner-price #{item.price}$
                .inner-stock Số Lượng: #{item.stock}
                button Đặt Hàng
                button Thêm vào giỏ hàng

                
            